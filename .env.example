# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cv_builder?schema=public"

# NextAuth.js (Generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Get from Google Cloud Console)
GOOGLE_ID="your-google-oauth-id.apps.googleusercontent.com"
GOOGLE_SECRET="your-google-oauth-secret"

# Google Gemini AI (Get from AI Studio)
GEMINI_API_KEY="your-gemini-api-key-here"

# Email Service (Optional - for SendGrid)
SENDGRID_API_KEY="your-sendgrid-api-key"

# Email Service (Optional - for Resend)
RESEND_API_KEY="your-resend-api-key"

# Payment Methods (Optional)
PAYMENT_BANK_ACCOUNT="XXXX-XXXX-XXXX"
PAYMENT_EASYPAISA="03XX-XXXXXXX"
PAYMENT_JAZZCASH="03XX-XXXXXXX"
PAYMENT_WHATSAPP="+92-XXX-XXXXXXX"

# Node environment
NODE_ENV="development"
